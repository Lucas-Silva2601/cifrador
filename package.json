{
  "name": "cifrador",
  "version": "2.0.0",
  "private": true,
  "author": "Cifrador",
  "description": "Aplicativo local-first para criar, organizar e transpor cifras (Next.js + React + Tailwind).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "test": "node --test src/chord-map.test.js src/chord-theory.test.js src/default-chords.test.js src/storage.test.js src/voicings.test.js api/ollama.test.js",
    "test:lib": "node --test lib/*.test.js 2>/dev/null || echo \"sem testes em lib (testes vivem em src/ e api/)\"",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run build && electron-builder --dir",
    "legacy:dev": "vite",
    "legacy:build": "vite build"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "br.com.cifrador.app",
    "productName": "Cifrador",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "desktop/**/*",
      "lib/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cifrador-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
